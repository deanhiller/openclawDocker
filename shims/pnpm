#!/usr/bin/env bash
# nx platform-guard shim for pnpm.
#
# Installed as ~/openclaw/bin/pnpm. Because it's a real file on PATH (not a
# shell function), EVERY subprocess — interactive shells, IDE runners, nx
# workers spawned via node child_process, scripts run via sh -c — finds it
# and the guard always fires before the real pnpm runs.
#
# Source of truth: openclawDocker1/shims/pnpm
set -euo pipefail

_self_dir="$(cd "$(dirname "$0")" && pwd)"

# Run the guard once per top-level invocation. The guard script strips
# "$_self_dir" from PATH internally, so any pnpm/npx it spawns finds the
# real binary without re-entering this shim.
_root=""
_d="$PWD"
while [ "$_d" != "/" ] && [ -n "$_d" ]; do
    if [ -e "$_d/.git" ]; then _root="$_d"; break; fi
    _d="$(dirname "$_d")"
done
if [ -n "$_root" ] && [ -x "$_self_dir/ensure-node-modules.sh" ]; then
    "$_self_dir/ensure-node-modules.sh" "$_root"
fi

# Strip our directory from PATH so `exec pnpm` finds the real binary,
# not this shim.
PATH=$(printf ':%s:' "$PATH" | sed "s|:$_self_dir:|:|g; s|^:||; s|:$||")
export PATH
exec pnpm "$@"
