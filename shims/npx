#!/usr/bin/env bash
# nx platform-guard shim for npx. See shims/pnpm for the rationale.
#
# Source of truth: openclawDocker1/shims/npx
set -euo pipefail

_self_dir="$(cd "$(dirname "$0")" && pwd)"

_root=""
_d="$PWD"
while [ "$_d" != "/" ] && [ -n "$_d" ]; do
    if [ -e "$_d/.git" ]; then _root="$_d"; break; fi
    _d="$(dirname "$_d")"
done
if [ -n "$_root" ] && [ -x "$_self_dir/ensure-node-modules.sh" ]; then
    "$_self_dir/ensure-node-modules.sh" "$_root"
fi

PATH=$(printf ':%s:' "$PATH" | sed "s|:$_self_dir:|:|g; s|^:||; s|:$||")
export PATH
exec npx "$@"
